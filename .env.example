# 默认直接监听云服内网 80 端口；公网访问由云厂商/NAT 自己映射到内网 80。
# 不要求 Nginx 或额外反向代理。若 80 已被其他服务占用，请先改 FEATHER_WEB_PORT。
FEATHER_BIND=0.0.0.0
FEATHER_WEB_PORT=80
# 使用 HTTPS 访问且由反代转发 HTTP 到面板时设为 1；HTTP 直连保留 0。
FEATHER_SECURE_COOKIE=0
FEATHER_PUBLIC_HOST=
# 默认关闭陌生人自助注册；需要多人账号时由管理员后续开放。
FEATHER_ALLOW_REGISTRATION=0
TZ=Asia/Shanghai
FEATHER_MEMORY_LIMIT=3g
FEATHER_CPU_LIMIT=2.0
# 可选；空值采用 DMP 的默认游戏令牌，实际有效性需开服验证。
FEATHER_CLUSTER_TOKEN=
# DMP 兼容的默认工坊搜索 Key 已内置；部署者可用自己的 Key 替换。
FEATHER_STEAM_API_KEY=
FEATHER_UPLOAD_MB=512
FEATHER_EXTRACT_MB=2048
# 自动翻译：默认免 Key MyMemory；off 关闭；libretranslate 对接自建服务。
# 只发送模组公开的配置名称、说明和选项文字，译文存储在数据卷数据库中。
FEATHER_TRANSLATION_PROVIDER=mymemory
# LibreTranslate 服务根地址，例如 http://libretranslate:5000/；Key 按服务要求填写。
FEATHER_TRANSLATION_URL=
FEATHER_TRANSLATION_KEY=
# 仅在官方仓库无法访问时，按自己的部署环境指定镜像/软件源。
# FEATHER_NODE_IMAGE=docker.1ms.run/library/node:24-bookworm-slim
# FEATHER_DEBIAN_MIRROR=http://mirrors.cloud.tencent.com

